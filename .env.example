DATABASE_URL=postgres://bsi:bsi_dev@localhost:5432/bsi_events
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Синхронизация курса ЦБ.
# RATES_AUTORUN=true — очередь разбирает сам процесс приложения. Годится для VPS,
# где процесс один и живёт постоянно. На serverless и при нескольких инстансах не включать:
# там задачу дёргает внешний планировщик запросом
# GET /api/payload-jobs/run?queue=rates с заголовком Authorization: Bearer $CRON_SECRET
RATES_AUTORUN=false
CRON_SECRET=
